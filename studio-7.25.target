<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<?pde version="3.8"?>
<target name="Anypoint Studio 7.25 / Eclipse 4.31 (2024-03)" sequenceNumber="2">
  <!--
    Portable target platform. Resolves the standard Eclipse + WTP bundles the plugin compiles against
    from the PUBLIC Eclipse 2024-03 simultaneous-release p2 repo, so NO local Anypoint Studio install
    is needed to build. The produced feature still installs into Anypoint Studio 7.25 (Eclipse 4.31);
    the bundle manifest pins no bundle versions, so exact patch differences vs. a given Studio build
    are harmless. To build on Linux/Windows, change the <environment> below (and <environments> in pom.xml).
  -->
  <locations>
    <location includeAllPlatforms="false" includeConfigurePhase="true" includeMode="planner" includeSource="false" type="InstallableUnit">
      <repository location="https://download.eclipse.org/releases/2024-03"/>
      <unit id="org.eclipse.jface.text" version="0.0.0"/>
      <unit id="org.eclipse.text" version="0.0.0"/>
      <unit id="org.eclipse.jface" version="0.0.0"/>
      <unit id="org.eclipse.swt" version="0.0.0"/>
      <unit id="org.eclipse.ui" version="0.0.0"/>
      <unit id="org.eclipse.ui.editors" version="0.0.0"/>
      <unit id="org.eclipse.ui.workbench.texteditor" version="0.0.0"/>
      <unit id="org.eclipse.ui.ide" version="0.0.0"/>
      <unit id="org.eclipse.core.runtime" version="0.0.0"/>
      <unit id="org.eclipse.core.resources" version="0.0.0"/>
      <unit id="org.eclipse.core.filebuffers" version="0.0.0"/>
      <unit id="org.eclipse.debug.core" version="0.0.0"/>
      <unit id="org.eclipse.wst.sse.core" version="0.0.0"/>
      <unit id="org.eclipse.wst.sse.ui" version="0.0.0"/>
      <unit id="org.eclipse.wst.xml.core" version="0.0.0"/>
      <unit id="org.eclipse.wst.xml.ui" version="0.0.0"/>
    </location>
  </locations>
  <environment>
    <os>macosx</os>
    <ws>cocoa</ws>
    <arch>aarch64</arch>
  </environment>
</target>
