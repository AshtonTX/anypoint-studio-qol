<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<?pde version="3.8"?>
<target name="Anypoint Studio 7.25.0 (Eclipse 4.31)" sequenceNumber="1">
  <locations>
    <!-- Treat the Studio install's plugins/ as a bundle pool. Pins compile-time classpath to the
         exact bundles Studio runs, so "resolves in IDE/Tycho" == "installs into Studio". -->
    <location path="/Applications/AnypointStudio.app/Contents/Eclipse/plugins" type="Directory"/>
  </locations>
  <environment>
    <os>macosx</os>
    <ws>cocoa</ws>
    <arch>aarch64</arch>
  </environment>
</target>
