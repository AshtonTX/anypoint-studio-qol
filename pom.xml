<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.studioqol</groupId>
  <artifactId>com.studioqol.parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Anypoint Studio QoL (parent)</name>

  <properties>
    <tycho-version>4.0.13</tycho-version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <modules>
    <module>com.studioqol</module>
    <module>com.studioqol.tests</module>
    <module>com.studioqol.feature</module>
    <module>com.studioqol.repository</module>
  </modules>

  <build>
    <plugins>
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>tycho-maven-plugin</artifactId>
        <version>${tycho-version}</version>
        <extensions>true</extensions>
      </plugin>
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>target-platform-configuration</artifactId>
        <version>${tycho-version}</version>
        <configuration>
          <!-- Repo-local target; resolves Eclipse/WTP from the public 2024-03 p2 repo (no local
               Studio install needed to build). Run mvn from the repo root. -->
          <target>
            <file>${maven.multiModuleProjectDirectory}/studio-7.25.target</file>
          </target>
          <!-- Use the build host's OS/window system/architecture. The plugin itself is portable;
               selecting native SWT dependencies here must also work for headless CI tests. -->
          <executionEnvironment>JavaSE-17</executionEnvironment>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
