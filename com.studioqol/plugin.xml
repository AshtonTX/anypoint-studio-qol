<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>

   <extension point="org.eclipse.ui.preferencePages">
      <page id="com.studioqol.preferences"
            name="Studio QoL"
            class="com.studioqol.ui.preferences.StudioQolPreferencePage"/>
   </extension>

   <!-- Feature 1: Property Value Hover.
        Registered as a WTP/SSE documentationTextHover on the XML default partition so it fires in
        Studio's "Configuration XML" editor. The built-in XML hover (XMLTagInfoHoverProcessor)
        returns null over ${...} tokens, so BestMatchHover selects ours there. -->
   <extension point="org.eclipse.wst.sse.ui.editorConfiguration">
      <documentationTextHover
            class="com.studioqol.feature.hover.PropertyHoverProcessor"
            target="org.eclipse.wst.xml.XML_DEFAULT">
      </documentationTextHover>
   </extension>

   <!-- Feature 1: Ctrl+click go-to-definition. Binds to the XML source editor's hyperlink target
        (org.eclipse.core.runtime.xml) so it fires in the Configuration XML editor. -->
   <extension point="org.eclipse.ui.workbench.texteditor.hyperlinkDetectors">
      <hyperlinkDetector
            class="com.studioqol.feature.hover.PropertyHyperlinkDetector"
            id="com.studioqol.hyperlink.property"
            name="Mule property definition"
            targetId="org.eclipse.core.runtime.xml">
      </hyperlinkDetector>
   </extension>

   <!-- Eager startup so the launch listener (active-env persistence) is registered at Studio
        startup, before the user runs a config. -->
   <extension point="org.eclipse.ui.startup">
      <startup class="com.studioqol.StudioQolStartup"/>
   </extension>

   <!-- Shared command category for all Studio QoL commands. -->
   <extension point="org.eclipse.ui.commands">
      <category
            id="com.studioqol.commands"
            name="Studio QoL"/>
      <command
            id="com.studioqol.command.findUsages"
            categoryId="com.studioqol.commands"
            name="Find Property Usages"
            description="Find all usages of the Mule property under the caret"/>
      <command
            id="com.studioqol.command.envSwitcher"
            categoryId="com.studioqol.commands"
            name="Active Mule Environment"
            description="Choose which environment is highlighted in property hovers and views (does not change run configurations)"/>
      <command
            id="com.studioqol.command.openEnvFile"
            categoryId="com.studioqol.commands"
            name="Open Environment Properties File"
            description="Open an envs/*.properties file of the active Mule project"/>
   </extension>

   <extension point="org.eclipse.ui.handlers">
      <handler
            commandId="com.studioqol.command.findUsages"
            class="com.studioqol.feature.usages.FindPropertyUsagesHandler"/>
      <handler
            commandId="com.studioqol.command.envSwitcher"
            class="com.studioqol.feature.envswitch.EnvSwitcherHandler"/>
      <handler
            commandId="com.studioqol.command.openEnvFile"
            class="com.studioqol.feature.envswitch.OpenEnvFileHandler"/>
   </extension>

   <!-- Suggested binding only (rebindable in Preferences > Keys). Cmd/Ctrl+Shift+8 is unbound in
        stock Eclipse 4.31 and JDT; deliberately avoids JDT's Cmd+Shift+G/U reference searches. -->
   <extension point="org.eclipse.ui.bindings">
      <key
            sequence="M1+M2+8"
            commandId="com.studioqol.command.findUsages"
            contextId="org.eclipse.ui.textEditorScope"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"/>
      <key
            sequence="M1+M2+9"
            commandId="com.studioqol.command.openEnvFile"
            contextId="org.eclipse.ui.contexts.window"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"/>
   </extension>

   <!-- popup.any (not #TextEditorContext) because the WTP/SSE Configuration XML editor uses its
        own context-menu id; visibility is scoped to text editors via activeContexts. -->
   <extension point="org.eclipse.ui.menus">
      <menuContribution locationURI="popup:org.eclipse.ui.popup.any?after=additions">
         <command
               commandId="com.studioqol.command.findUsages"
               label="Find Property Usages"
               style="push">
            <visibleWhen checkEnabled="false">
               <with variable="activeContexts">
                  <iterate operator="or">
                     <equals value="org.eclipse.ui.textEditorScope"/>
                  </iterate>
               </with>
            </visibleWhen>
         </command>
      </menuContribution>
      <!-- Env switcher: pulldown button in the main toolbar; the arrow opens the dynamic env menu. -->
      <menuContribution locationURI="toolbar:org.eclipse.ui.main.toolbar?after=additions">
         <toolbar id="com.studioqol.toolbar">
            <command
                  commandId="com.studioqol.command.envSwitcher"
                  style="pulldown"
                  icon="icons/env_switch.png"
                  label="Env"
                  tooltip="Studio QoL: active Mule environment (highlight only)"/>
         </toolbar>
      </menuContribution>
      <menuContribution locationURI="menu:com.studioqol.command.envSwitcher">
         <dynamic
               id="com.studioqol.envSwitcher.items"
               class="com.studioqol.feature.envswitch.EnvSwitcherMenu"/>
      </menuContribution>
   </extension>

   <extension point="org.eclipse.search.searchResultViewPages">
      <viewPage
            id="com.studioqol.search.usagePage"
            label="Property Usages"
            searchResultClass="com.studioqol.feature.usages.PropertyUsageResult"
            class="com.studioqol.feature.usages.PropertyUsageResultPage"/>
   </extension>

   <!-- Property validation markers. Transient: startup validation repopulates them each session. -->
   <extension point="org.eclipse.core.resources.markers" id="problem" name="Studio QoL Property Problem">
      <super type="org.eclipse.core.resources.problemmarker"/>
      <super type="org.eclipse.core.resources.textmarker"/>
      <persistent value="false"/>
      <attribute name="qolKey"/>
      <attribute name="qolSecure"/>
      <attribute name="qolMissingEnvs"/>
   </extension>
   <extension point="org.eclipse.core.resources.markers" id="problem.undefined" name="Undefined Property">
      <super type="com.studioqol.problem"/>
      <persistent value="false"/>
   </extension>
   <extension point="org.eclipse.core.resources.markers" id="problem.missingEnv" name="Property Missing in Environment">
      <super type="com.studioqol.problem"/>
      <persistent value="false"/>
   </extension>
   <extension point="org.eclipse.core.resources.markers" id="problem.unused" name="Unused Property">
      <super type="com.studioqol.problem"/>
      <persistent value="false"/>
   </extension>

   <extension point="org.eclipse.ui.views">
      <category
            id="com.studioqol.views"
            name="Studio QoL"/>
      <view
            id="com.studioqol.view.envComparison"
            name="Env Comparison"
            category="com.studioqol.views"
            class="com.studioqol.feature.compare.EnvComparisonView"
            icon="icons/env_switch.png"/>
   </extension>

   <!-- Quick fixes. Registered per concrete type — the resolution registry does not walk subtypes. -->
   <extension point="org.eclipse.ui.ide.markerResolution">
      <markerResolutionGenerator
            markerType="com.studioqol.problem.undefined"
            class="com.studioqol.feature.quickfix.PropertyMarkerResolutionGenerator"/>
      <markerResolutionGenerator
            markerType="com.studioqol.problem.missingEnv"
            class="com.studioqol.feature.quickfix.PropertyMarkerResolutionGenerator"/>
      <markerResolutionGenerator
            markerType="com.studioqol.problem.unused"
            class="com.studioqol.feature.quickfix.PropertyMarkerResolutionGenerator"/>
   </extension>

</plugin>
