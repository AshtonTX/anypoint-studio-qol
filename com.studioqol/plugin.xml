<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>

   <!-- Feature 1: Property Value Hover.
        Registered as a WTP/SSE documentationTextHover on the XML default partition so it fires in
        Studio's "Configuration XML" editor. The built-in XML hover (XMLTagInfoHoverProcessor)
        returns null over ${...} tokens, so BestMatchHover selects ours there. -->
   <extension point="org.eclipse.wst.sse.ui.editorConfiguration">
      <documentationTextHover
            class="com.studioqol.feature.hover.PropertyHoverProcessor"
            target="org.eclipse.wst.xml.XML_DEFAULT">
      </documentationTextHover>
   </extension>

   <!-- Feature 1: Ctrl+click go-to-definition. Binds to the XML source editor's hyperlink target
        (org.eclipse.core.runtime.xml) so it fires in the Configuration XML editor. -->
   <extension point="org.eclipse.ui.workbench.texteditor.hyperlinkDetectors">
      <hyperlinkDetector
            class="com.studioqol.feature.hover.PropertyHyperlinkDetector"
            id="com.studioqol.hyperlink.property"
            name="Mule property definition"
            targetId="org.eclipse.core.runtime.xml">
      </hyperlinkDetector>
   </extension>

   <!-- Eager startup so the launch listener (active-env persistence) is registered at Studio
        startup, before the user runs a config. -->
   <extension point="org.eclipse.ui.startup">
      <startup class="com.studioqol.StudioQolStartup"/>
   </extension>

   <!-- Shared command category for all Studio QoL commands. -->
   <extension point="org.eclipse.ui.commands">
      <category
            id="com.studioqol.commands"
            name="Studio QoL"/>
      <command
            id="com.studioqol.command.findUsages"
            categoryId="com.studioqol.commands"
            name="Find Property Usages"
            description="Find all usages of the Mule property under the caret"/>
   </extension>

   <extension point="org.eclipse.ui.handlers">
      <handler
            commandId="com.studioqol.command.findUsages"
            class="com.studioqol.feature.usages.FindPropertyUsagesHandler"/>
   </extension>

   <!-- Suggested binding only (rebindable in Preferences > Keys). Cmd/Ctrl+Shift+8 is unbound in
        stock Eclipse 4.31 and JDT; deliberately avoids JDT's Cmd+Shift+G/U reference searches. -->
   <extension point="org.eclipse.ui.bindings">
      <key
            sequence="M1+M2+8"
            commandId="com.studioqol.command.findUsages"
            contextId="org.eclipse.ui.textEditorScope"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"/>
   </extension>

   <!-- popup.any (not #TextEditorContext) because the WTP/SSE Configuration XML editor uses its
        own context-menu id; visibility is scoped to text editors via activeContexts. -->
   <extension point="org.eclipse.ui.menus">
      <menuContribution locationURI="popup:org.eclipse.ui.popup.any?after=additions">
         <command
               commandId="com.studioqol.command.findUsages"
               label="Find Property Usages"
               style="push">
            <visibleWhen checkEnabled="false">
               <with variable="activeContexts">
                  <iterate operator="or">
                     <equals value="org.eclipse.ui.textEditorScope"/>
                  </iterate>
               </with>
            </visibleWhen>
         </command>
      </menuContribution>
   </extension>

   <extension point="org.eclipse.search.searchResultViewPages">
      <viewPage
            id="com.studioqol.search.usagePage"
            label="Property Usages"
            searchResultClass="com.studioqol.feature.usages.PropertyUsageResult"
            class="com.studioqol.feature.usages.PropertyUsageResultPage"/>
   </extension>

</plugin>
